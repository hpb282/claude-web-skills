{
  "name": "mam-chu-writing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:unit": "node --test tests-unit/*.test.js",
    "build:html": "npm run build && node scripts/package-html.mjs",
    "build:slides": "npm run build && node scripts/package-html.mjs --slides-only",
    "test:slides": "node scripts/check-slides.mjs",
    "test:html": "node scripts/check-html.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "gsap": "3.15.1",
    "three": "0.187.0",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
